# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kovian_finance
# Use a randomly generated secret of at least 32 characters.
JWT_SECRET=

# OAuth 2.0 Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Only this verified Google account receives the admin role.
KOVIAN_ADMIN_EMAIL=ruannpersonal@gmail.com
