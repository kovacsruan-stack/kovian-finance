# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kovian_finance
# Use a randomly generated secret of at least 32 characters.
JWT_SECRET=
# Server-to-server Gestão payment ingestion (never expose these to the frontend).
KOVIAN_FINANCE_INTEGRATION_TOKEN=
KOVIAN_FINANCE_OWNER_ID=
