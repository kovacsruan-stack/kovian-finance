# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kovian_finance
# Use a randomly generated secret of at least 32 characters.
JWT_SECRET=

# Optional service-to-service authentication for Gestão payment ingestion.
# Set a high-entropy secret (32+ characters) in the deployment secret manager.
GESTAO_INTEGRATION_TOKEN=
# JSON object: {"<gestao-owner-uuid>": "<finance-user-id>"}; configure server-side only.
GESTAO_OWNER_MAP={}
# JSON object: {"<gestao-owner-uuid>": "<approved-finance-account-id>"}.
GESTAO_ACCOUNT_MAP={}
